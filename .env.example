# Database (NeonTech)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Identity and Community Edition
BETTER_AUTH_SECRET="generate_at_least_32_random_characters"
BETTER_AUTH_URL="http://localhost:3000"
AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# Keep this exact value. This repository ships Community Edition.
APP_EDITION="community"

# One-time access bootstrap. Keep the password outside Git.
COMMUNITY_BOOTSTRAP_EMAIL="operator@example.org"
COMMUNITY_BOOTSTRAP_NAME="Operador principal"
COMMUNITY_BOOTSTRAP_PASSWORD="set_an_easy_private_passphrase_with_12_or_more_characters"

# NASA FIRMS API
FIRMS_MAP_KEY="your_firms_map_key_here"

# GOES-19 FDCF Integration (optional but recommended)
# Google Cloud project must be registered for Earth Engine and have the API enabled.
EARTH_ENGINE_PROJECT_ID="your-google-cloud-project-id"
EARTH_ENGINE_SERVICE_ACCOUNT_JSON_BASE64="base64_encoded_service_account_json"
GOES_NOAA_S3_FALLBACK="true"
GOES_MAX_FALLBACK_MINUTES="120"

# Sentinel-3 SLSTR (optional)
# Product discovery requires EUMETSAT credentials. Hotspot extraction requires
# a preprocessed GeoJSON feed supplied by your own processing pipeline.
EUMETSAT_CONSUMER_KEY="your-eumetsat-consumer-key"
EUMETSAT_CONSUMER_SECRET="your-eumetsat-consumer-secret"
SENTINEL3_FRP_GEOJSON_URL="https://your-domain.example/sentinel3-frp.geojson"
SENTINEL3_FRP_LOOKBACK_HOURS="6"

# NASA HLS public catalog (optional)
HLS_ENABLED="true"
HLS_LOOKBACK_DAYS="10"

# Next.js
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_MAP_STYLE="https://demotiles.maplibre.org/style.json"
NODE_ENV="development"

# Jurisdiction. Demo values must be replaced before operational use.
NEXT_PUBLIC_JURISDICTION_NAME="Jurisdicción demo"
NEXT_PUBLIC_JURISDICTION_TIMEZONE="UTC"
NEXT_PUBLIC_BBOX_WEST="-67"
NEXT_PUBLIC_BBOX_SOUTH="-32"
NEXT_PUBLIC_BBOX_EAST="-63"
NEXT_PUBLIC_BBOX_NORTH="-28"
NEXT_PUBLIC_MAP_CENTER_LAT="-30"
NEXT_PUBLIC_MAP_CENTER_LON="-65"
NEXT_PUBLIC_MAP_ZOOM="7"
